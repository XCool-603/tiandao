# 天道大模型配置 (支持任意兼容 OpenAI 接口的平台，如 DeepSeek, SiliconFlow, 月之暗面, 智谱, 官方OpenAI, 本地Ollama等)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat

# 可选：单独为天道指定更强的大模型（留空则默认使用 MODEL_NAME）
TIANDAO_MODEL=deepseek-reasoner

# 可选：单独为史官（小说著书润色）指定大模型（留空则默认使用 MODEL_NAME）
CHRONICLER_MODEL=deepseek-chat

# 运行参数
MAX_ROUNDS=6
AUTO_GENERATE_NOVEL=true

# 管理端独立安全密钥（用于后台配置与在线更新验证）
ADMIN_KEY=admin888
